{
  "name": "@dreamcode/desktop",
  "version": "0.2.6",
  "author": "DreamCode Contributors",
  "description": "DreamCode local coding agent for Windows",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "main": "dist-main/main/index.js",
  "scripts": {
    "build": "pnpm run build:main && pnpm run build:renderer",
    "build:contracts": "tsup",
    "build:main": "tsup",
    "build:renderer": "vite build",
    "chain-test": "node scripts/packaged-chain-test.mjs",
    "checksums": "node scripts/write-checksums.mjs",
    "dev": "vite",
    "dist": "pnpm run build && pnpm run dist:package",
    "dist:package": "electron-builder --config electron-builder.yml --win --x64",
    "e2e": "playwright test --config playwright.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dreamcode/context": "workspace:*",
    "@dreamcode/core": "workspace:*",
    "@dreamcode/models": "workspace:*",
    "@dreamcode/shared": "workspace:*",
    "@dreamcode/store": "workspace:*",
    "@dreamcode/tools": "workspace:*",
    "@fontsource/noto-sans-sc": "5.3.0",
    "@lobehub/icons-static-svg": "1.94.0",
    "@shikijs/langs": "4.3.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "lucide-react": "1.31.0",
    "node-pty": "1.1.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "shiki": "4.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "jsdom": "30.0.1",
    "vite": "8.2.1"
  }
}
