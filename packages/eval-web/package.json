{
  "name": "@dreamcode/eval-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @dreamcode/evals... build && vite build && tsup src/server.ts --format esm --out-dir dist-server --clean --external vite",
    "dev": "tsx --conditions=development src/server.ts --dev",
    "start": "node dist-server/server.js",
    "typecheck": "tsc -p ../../tsconfig.typecheck.json --noEmit"
  },
  "dependencies": {
    "@dreamcode/evals": "workspace:*",
    "@fontsource/inter": "^5.3.0",
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-select": "^2.3.8",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "vite": "8.2.1"
  }
}
