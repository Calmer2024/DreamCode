{
  "name": "@dreamcode/evals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./dataset": {
      "types": "./src/dataset/index.ts",
      "development": "./src/dataset/index.ts",
      "import": "./dist/dataset/index.js"
    },
    "./dataset/composite": {
      "types": "./src/dataset/composite.ts",
      "development": "./src/dataset/composite.ts",
      "import": "./dist/dataset/composite.js"
    }
  },
  "bin": {
    "dreamcode-eval": "dist/cli.js",
    "dreameval-dataset": "dist/dataset/cli.js"
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts src/dataset/index.ts src/dataset/cli.ts src/dataset/composite.ts --format esm --clean",
    "typecheck": "tsc -p ../../tsconfig.typecheck.json --noEmit",
    "eval": "tsx --conditions=development src/cli.ts",
    "eval:dataset": "tsx --conditions=development src/dataset/cli.ts"
  },
  "dependencies": {
    "@dreamcode/core": "workspace:*",
    "@dreamcode/models": "workspace:*",
    "@dreamcode/shared": "workspace:*",
    "@dreamcode/store": "workspace:*",
    "@dreamcode/safety": "workspace:*",
    "@dreamcode/tools": "workspace:*",
    "openai": "^6.7.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "tsx": "^4.20.6",
    "tsup": "^8.5.0"
  }
}
